diff --git a/src/pages/admin/ayuda/+Page.tsx b/src/pages/admin/ayuda/+Page.tsx
new file mode 100644
index 0000000..64b34bb
--- /dev/null
+++ b/src/pages/admin/ayuda/+Page.tsx
@@ -0,0 +1,108 @@
+"use client";
+
+import { useEffect, useState } from 'react';
+import { navigate } from 'vike/client/router';
+import { getCurrentUser, signOut as authSignOut } from '@/services/forumService';
+import { getUserProfile } from '@/services/profileService';
+import AdminShell from '@/components/admin/AdminShell';
+
+const Page = () => {
+  const [email, setEmail] = useState<string | null>(null);
+  const [ok, setOk] = useState(false);
+
+  useEffect(() => {
+    const run = async () => {
+      const user = await getCurrentUser();
+      if (!user) {
+        navigate('/admin/login');
+        return;
+      }
+      setEmail(user.email || null);
+      const profile = await getUserProfile(user.id);
+      if (profile?.role !== 'admin') {
+        navigate('/admin/dashboard');
+        return;
+      }
+      setOk(true);
+    };
+    run();
+  }, []);
+
+  const handleSignOut = async () => {
+    await authSignOut();
+    navigate('/admin/login');
+  };
+
+  if (!ok) {
+    return (
+      <AdminShell email={email} onSignOut={handleSignOut} current="ayuda">
+        <p className="text-sm text-muted-foreground">Cargando…</p>
+      </AdminShell>
+    );
+  }
+
+  return (
+    <AdminShell email={email} onSignOut={handleSignOut} current="ayuda">
+      <article className="prose prose-sm max-w-3xl dark:prose-invert">
+        <h1 className="text-3xl font-bold text-primary">Cómo usar el panel</h1>
+        <p>
+          Este panel no es el sitio público. Aquí publicas notas, lees mensajes de Contacto y ves
+          cuántas personas registraron intención de donar. El dinero y el WhatsApp de atención
+          siguen fuera.
+        </p>
+
+        <h2>Entrar y salir</h2>
+        <ol>
+          <li>Ve a <code>/admin/login</code>. No hay “Regístrate” a propósito.</li>
+          <li>Usa el correo de la A.C. con rol <strong>admin</strong> en la tabla <code>profiles</code>.</li>
+          <li>Si te dice que la cuenta no es admin: en Supabase, <code>update profiles set role = 'admin' where email = 'tu@correo'</code>.</li>
+          <li>Al terminar, <strong>Salir</strong>. No dejes la sesión abierta en una computadora compartida.</li>
+        </ol>
+
+        <h2>Publicar una nota</h2>
+        <ol>
+          <li>Menú <strong>Nueva nota</strong>.</li>
+          <li>Título (claro), autor, resumen de 1–2 líneas (sale en el listado).</li>
+          <li><strong>Subir desde la PC</strong> la portada (JPG/PNG/WEBP/GIF, máx. 5 MB). O pega una URL.</li>
+          <li>Escribe el cuerpo. Barra: negrita, cursiva, título, lista, cita, enlace. <strong>Imagen en el texto</strong> inserta otra foto donde está el cursor.</li>
+          <li><strong>Vista previa</strong> antes de publicar.</li>
+          <li>Publicar. La nota aparece en <code>/blog</code> y, si es reciente, en el home.</li>
+        </ol>
+        <p>
+          Si “Subir desde la PC” falla: falta el bucket <code>blog-images</code> (SQL que te pasamos).
+          No publiques fotos donde se identifique a una mujer atendida por violencia.
+        </p>
+
+        <h2>Mensajes de contacto</h2>
+        <ol>
+          <li>Menú <strong>Mensajes</strong>. Empieza en Pendientes.</li>
+          <li>Lee. Si es pedido de ayuda, contesta por WhatsApp o teléfono; no por el foro.</li>
+          <li>Si es prensa o donante, <strong>Responder por correo</strong>.</li>
+          <li>Cuando ya contestaste, <strong>Marcar respondido</strong>.</li>
+        </ol>
+
+        <h2>Donativos</h2>
+        <p>
+          El número del resumen cuenta <em>intenciones</em> (alguien llenó Donar). El pago ocurre en
+          Mercado Pago, transferencia o WhatsApp. En 48 horas: agradece y, si pidieron CFDI, emítelo.
+        </p>
+
+        <h2>Usuarios</h2>
+        <p>
+          “Hacer admin” da poder de borrar notas y leer mensajes. Solo cuentas del equipo.
+          No quites el último admin: el panel queda cerrado.
+        </p>
+
+        <h2>Lo que este panel no hace</h2>
+        <ul>
+          <li>No cobra tarjetas.</li>
+          <li>No envía el boletín.</li>
+          <li>No sustituye el 911.</li>
+          <li>No debe publicarse el enlace en el home.</li>
+        </ul>
+      </article>
+    </AdminShell>
+  );
+};
+
+export default Page;
