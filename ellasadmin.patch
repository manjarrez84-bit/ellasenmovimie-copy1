diff --git a/src/components/admin/AdminShell.tsx b/src/components/admin/AdminShell.tsx
new file mode 100644
index 0000000..a5e1222
--- /dev/null
+++ b/src/components/admin/AdminShell.tsx
@@ -0,0 +1,72 @@
+"use client";
+
+import { ReactNode } from 'react';
+import { Mail, LayoutDashboard, LogOut, ExternalLink, PenSquare, CircleHelp } from 'lucide-react';
+
+type AdminShellProps = {
+  children: ReactNode;
+  email?: string | null;
+  onSignOut?: () => void;
+  current?: 'dashboard' | 'messages' | 'new-post' | 'users' | 'ayuda';
+};
+
+const links = [
+  { href: '/admin/dashboard', id: 'dashboard', label: 'Resumen', icon: LayoutDashboard },
+  { href: '/admin/blog/new', id: 'new-post', label: 'Nueva nota', icon: PenSquare },
+  { href: '/admin/messages', id: 'messages', label: 'Mensajes', icon: Mail },
+  { href: '/admin/ayuda', id: 'ayuda', label: 'Cómo usar', icon: CircleHelp },
+];
+
+export default function AdminShell({ children, email, onSignOut, current = 'dashboard' }: AdminShellProps) {
+  return (
+    <div className="min-h-screen bg-muted/40">
+      <header className="sticky top-0 z-40 border-b bg-background">
+        <div className="container mx-auto px-4 py-3 flex flex-wrap items-center justify-between gap-3">
+          <div className="flex items-center gap-3">
+            <img src="/logo.jpg" alt="" className="h-10 w-auto" />
+            <div>
+              <p className="text-sm font-bold text-primary leading-tight">Panel Ellas</p>
+              <p className="text-xs text-muted-foreground">{email || 'Administración'}</p>
+            </div>
+          </div>
+          <nav className="flex flex-wrap items-center gap-1">
+            {links.map((item) => {
+              const Icon = item.icon;
+              const active = current === item.id;
+              return (
+                <a
+                  key={item.href}
+                  href={item.href}
+                  className={`inline-flex items-center gap-1.5 rounded-md px-3 py-2 text-sm font-medium ${
+                    active ? 'bg-primary text-primary-foreground' : 'text-foreground hover:bg-muted'
+                  }`}
+                >
+                  <Icon className="h-4 w-4" />
+                  {item.label}
+                </a>
+              );
+            })}
+            <a
+              href="/"
+              className="inline-flex items-center gap-1.5 rounded-md px-3 py-2 text-sm text-foreground hover:bg-muted"
+            >
+              <ExternalLink className="h-4 w-4" />
+              Ver sitio
+            </a>
+            {onSignOut && (
+              <button
+                type="button"
+                onClick={onSignOut}
+                className="inline-flex items-center gap-1.5 rounded-md px-3 py-2 text-sm text-foreground hover:bg-muted"
+              >
+                <LogOut className="h-4 w-4" />
+                Salir
+              </button>
+            )}
+          </nav>
+        </div>
+      </header>
+      <main className="container mx-auto px-4 py-8 max-w-6xl">{children}</main>
+    </div>
+  );
+}
